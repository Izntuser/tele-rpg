{
  "version": 1,
  "disable_existing_loggers": false,
  "filters": {"redact": {"()": "app.core.logging.RedactFilter"}},
  "formatters": {"plain": {"format": "%(levelname)s %(name)s %(message)s"}},
  "handlers": {
    "stdout": {"class": "logging.StreamHandler", "formatter": "plain", "stream": "ext://sys.stdout"}
  },
  "loggers": {
    "uvicorn": {"handlers": ["stdout"], "level": "INFO", "propagate": false},
    "uvicorn.access": {"handlers": ["stdout"], "filters": ["redact"], "level": "INFO", "propagate": false}
  }
}
