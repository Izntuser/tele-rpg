# Copy to .env for local overrides. init.sh and scripts/smoke.sh source .env, else this file;
# every value below equals the built-in default. Dev placeholders only, never real secrets.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://telerpg:telerpg@localhost:5432/telerpg
TEST_DATABASE_URL=postgresql+asyncpg://telerpg:telerpg@localhost:5432/telerpg_test
E2E_DATABASE_URL=postgresql+asyncpg://telerpg:telerpg@localhost:5432/telerpg_e2e
# Fixed fake token: never used for real Telegram calls.
TG_BOT_TOKEN=123456789:AAFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKE
JWT_SECRET=dev-jwt-secret-change-me

# --- Live stack (scripts/live.sh), real Telegram. Put the real values in .env only. ---
# Live API / web (vite) ports; they run next to the test stack (8000/3000).
LIVE_API_PORT=8010
LIVE_WEB_PORT=3010
