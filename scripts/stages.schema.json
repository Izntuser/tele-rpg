{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "stages",
  "type": "object",
  "required": ["stages"],
  "additionalProperties": false,
  "properties": {
    "stages": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/stage" } }
  },
  "definitions": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "goal", "depends_on", "files", "complexity", "risk", "ui",
                   "dod_command", "browser_check", "test_steps", "passes", "attempts", "blocked_reason"],
      "properties": {
        "id": { "type": "string", "pattern": "^S[0-9]{2,3}$" },
        "goal": { "type": "string", "minLength": 10 },
        "depends_on": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^S[0-9]{2,3}$" } },
        "files": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "complexity": { "enum": ["low", "medium", "high"] },
        "risk": { "enum": ["normal", "sensitive"] },
        "ui": { "type": "boolean" },
        "dod_command": { "type": "string", "minLength": 3 },
        "browser_check": { "type": ["string", "null"] },
        "test_steps": { "type": "array", "minItems": 3, "maxItems": 6, "items": { "type": "string" } },
        "passes": { "type": "boolean" },
        "attempts": { "type": "integer", "minimum": 0 },
        "blocked_reason": { "type": ["string", "null"] }
      },
      "if": { "properties": { "ui": { "const": true } } },
      "then": { "properties": { "browser_check": { "type": "string", "minLength": 3 } } }
    }
  }
}
